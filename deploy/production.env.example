APP_ENV=production
WEB_PORT=80
DB_NAME=ai_for
DB_USER=ai_for
DB_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
# 独立于 JWT_SECRET；用于生成 API Key 的 HMAC 摘要。
API_KEY_PEPPER=replace-with-a-different-long-random-secret
JWT_EXPIRE_HOURS=24
EMAIL_MOCK=true
